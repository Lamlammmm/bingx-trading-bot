# Copy to .env. Generate BOT_API_KEY with: openssl rand -hex 32
BOT_API_KEY=
# Keep this fixed so manual deployments and CI/CD share the same state volume.
COMPOSE_PROJECT_NAME=bingx-bot
BOT_HTTP_PORT=8080
BOT_ENABLED=true
LIVE_ENABLED=false
BINGX_API_KEY=
BINGX_API_SECRET=
PERSISTENCE_PROVIDER=Sqlite
SUPABASE_DB_CONNECTION_STRING=
BINGX__HISTORYLIMIT=250
RISK__STARTINGBALANCE=10000
RISK__RISKPERTRADEPERCENT=0.5
RISK__MAXDAILYLOSSPERCENT=2
RISK__MAXLEVERAGE=20
RISK__TARGETPROFITUSDT=0
OPENAI__ENABLED=false
OPENAI__MODEL=gpt-5.2
OPENAI_API_KEY=
# Optional tools profile: set SEQ_URL=http://seq:80 to send logs to Seq.
SEQ_URL=
