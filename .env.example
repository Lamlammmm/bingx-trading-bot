# Paper trading only. No BingX API key/secret is required for public market data.
# NOTE: env var keys must match the appsettings.json section names directly
# (BingX / Strategy / Risk / OpenAI) - there is no "TradingBot" wrapper section.
# Multiple symbols: use indexed keys (BINGX__SYMBOLS__0, __1, __2, ...).
BINGX__SYMBOLS__0=BTC-USDT
BINGX__SYMBOLS__1=ETH-USDT
BINGX__HISTORYLIMIT=250
RISK__STARTINGBALANCE=10000
RISK__RISKPERTRADEPERCENT=0.5
RISK__MAXDAILYLOSSPERCENT=2
RISK__MAXLEVERAGE=20
RISK__TARGETPROFITUSDT=1
OPENAI__ENABLED=false
OPENAI__MODEL=gpt-5.2
OPENAI__MINIMUMCONFIDENCE=0.6

# Used only when OPENAI__ENABLED=true.
BINGX_API_KEY=
BINGX_API_SECRET=
OPENAI_API_KEY=

# Live executor is not implemented in Phase 1.

# Structured log server (optional). When running via docker-compose this is set
# automatically to http://seq:80; leave blank to log to console only.
SEQ__URL=
