# Paper trading only. No BingX API key/secret is required for public market data.
TRADINGBOT__BINGX__SYMBOL=BTC-USDT
TRADINGBOT__BINGX__HISTORYLIMIT=250
TRADINGBOT__RISK__STARTINGBALANCE=10000
TRADINGBOT__RISK__RISKPERTRADEPERCENT=0.5
TRADINGBOT__RISK__MAXDAILYLOSSPERCENT=2
TRADINGBOT__RISK__MAXLEVERAGE=3
TRADINGBOT__OPENAI__ENABLED=false
TRADINGBOT__OPENAI__MODEL=gpt-5.2
TRADINGBOT__OPENAI__MINIMUMCONFIDENCE=0.6

# Used only when TRADINGBOT__OPENAI__ENABLED=true.
BINGX_API_KEY=
BINGX_API_SECRET=
OPENAI_API_KEY=

