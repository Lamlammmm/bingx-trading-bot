{
  "BingX": {
    "RestBaseUrl": "https://open-api.bingx.com",
    "WebSocketUrl": "wss://open-api-swap.bingx.com/swap-market",
    "Symbols": [ "BTC-USDT", "ETH-USDT", "SOL-USDT", "BNB-USDT", "CYS-USDT" ],
    "HistoryLimit": 250,
    "RequestTimeoutSeconds": 20,
    "ReconnectDelaySeconds": 5,
    "LogRawPriceUpdates": false
  },
  "Strategy": {
    "FastEmaPeriod": 20,
    "SlowEmaPeriod": 50,
    "BreakoutLookback": 20,
    "VolumeLookback": 20,
    "VolumeMultiplier": 1.2,
    "AtrPeriod": 14,
    "RsiPeriod": 14,
    "RsiOverbought": 75,
    "RsiOversold": 25,
    "MinimumBodyRatio": 0.5,
    "SignalCooldownBars": 4
  },
  "Risk": {
    "StartingBalance": 10000,
    "RiskPerTradePercent": 0.5,
    "MaxDailyLossPercent": 2,
    "MaxLeverage": 3,
    "StopAtrMultiplier": 1.5,
    "TakeProfitRiskMultiple": 2,
    "FeeRate": 0.0005,
    "MinimumQuantity": 0.0001,
    "MaximumStopAtrMultiplier": 3,
    "MinimumTakeProfitRiskMultiple": 1.5,
    "MaxAggregateOpenRiskPercent": 2
  },
  "OpenAI": {
    "Enabled": false,
    "Model": "gpt-5.2",
    "BaseUrl": "https://api.openai.com/v1/",
    "RequestTimeoutSeconds": 45,
    "CandleCountPerTimeFrame": 60,
    "MaximumEntryDeviationPercent": 0.25,
    "MinimumConfidence": 0.6
  },
  "Persistence": {
    "Provider": "Postgres",
    "DatabasePath": "data/tradingbot.db"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "System.Net.Http.HttpClient": "Warning"
    }
  }
}
